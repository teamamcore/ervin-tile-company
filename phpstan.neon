includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Laravel's own stock config files pass env() values straight into
    # string-typed helpers (explode, Str::slug, parse_url); Larastan's env()
    # stub returns bool|string here even though runtime values are always
    # strings. These files are framework boilerplate, not app code.
    ignoreErrors:
        -
            identifier: argument.type
            path: config/*.php
